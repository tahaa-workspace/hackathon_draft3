# Core application
MONGO_URI=
JWT_SECRET=
PORT=5000
APP_BASE_URL=http://localhost:5173

# Optional: only set this if your network requires custom DNS for MongoDB SRV.
# Example: DNS_SERVERS=8.8.8.8,1.1.1.1
DNS_SERVERS=

# Private Cloudinary storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AES-256-GCM keys. Each key must decode to exactly 32 bytes.
# A 64-character hexadecimal value is supported.
DOCUMENT_ENCRYPTION_KEY=
AADHAAR_ENCRYPTION_KEY=

# SMTP / Nodemailer
# MAIL_USER authenticates the SMTP sender account. It is never used as the
# recipient for registration, allocation, claim, or legal-assistance emails.
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM="NextGen Vault <your-sender@gmail.com>"
CONTACT_RECEIVER_EMAIL=

# Gmail setup:
# 1. Enable 2-Step Verification on the dedicated sender account.
# 2. Create a Google App Password for mail.
# 3. Put that App Password in MAIL_PASSWORD. Do not use the normal Gmail password.
# 4. Set MAIL_FROM to the same authorized sender address/name.
#
# Other SMTP providers can be used by replacing MAIL_HOST/MAIL_PORT/MAIL_SECURE.
# Never commit real credentials to Git.

# Backward-compatible SMTP fallbacks supported by the current mailer.
# Prefer MAIL_USER and MAIL_PASSWORD for all new environments.
# EMAIL_USER=
# EMAIL_APP_PASSWORD=
