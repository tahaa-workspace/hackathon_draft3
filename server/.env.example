# Copy this file to .env and fill in real values.
# .env is git-ignored and will never be committed.

# Port the Express API listens on
PORT=5000

# MongoDB Atlas connection string.
# In MongoDB Atlas: Database → Connect → Drivers → "Add your connection string into your application code".
# Replace <db_password> with the database user password and set the database name to digitalLegacy.
# Example: mongodb+srv://dlegacy_user:<password>@cluster0.xxxxx.mongodb.net/digitalLegacy?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://dlegacy_user:<password>@cluster0.xxxxx.mongodb.net/digitalLegacy?retryWrites=true&w=majority

# Secret used to sign JWTs — any long random string (32+ chars recommended)
JWT_SECRET=change_this_to_a_long_random_secret_value

# Cloudinary account used for private/protected document storage.
# Create these in your Cloudinary dashboard and place the real values only in server/.env.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Initial Admin bootstrap credentials (used only by `npm run seed`)
# Do NOT use these for production. Create your own strong credentials.
ADMIN_NAME=System Administrator
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@digitallegacy.local
ADMIN_PASSWORD=ChangeMeNow123!
